# Ignore log files
logs/*
logs/ossec.log*
logs/monitoring-*.log*

# Ignore runtime files and queue databases
var/run/*
var/lib/*
queue/**
queue/rids/*
queue/agents/*
queue/diff/*
queue/ossec/*
queue/fim/**
queue/logcollector/**
queue/sockets/**
queue/syscollector/**

# Ignore backup files
etc/ossec.conf.backup.*
etc/*.save

# Ignore database files
backup/db/*.gz

# Ignore temporary files
tmp/*
.setup_complete

# Keep directory structure but ignore contents
!logs/.gitkeep
!var/run/.gitkeep
!queue/rids/.gitkeep
# Ensure client keys file isn't committed
etc/client.keys

# Large binary artifacts – too big for GitHub (>100 MB)
monitoring_agent.zip
*.msi
*.cld
*.cvd
src/win32/agent/agent.zip
src/win32/agent/RiskNoX-*.exe
src/win32/monitoring-suite-*.exe
src/suricatamonitoring/suricatamonitoring.zip
src/suricatamonitoring/suricata/bin/suricata.exe
src/win32/suricata/bin/suricata.exe
src/win32/agent/suricata/bin/suricata.exe
src/win32/agent/suricata/log/eve.json
