        <CustomAction Id="RunSetupWindows" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]setup-windows.exe&quot; &quot;[INSTALLFOLDER]&quot;" Execute="deferred" Impersonate="no" Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="InstallService" Before="InstallFinalize">NOT Installed</Custom>
            <Custom Action="RunSetupWindows" After="InstallService">NOT Installed</Custom>
        </InstallExecuteSequence>
