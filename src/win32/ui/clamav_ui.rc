#include <windows.h>
#include "clamav_ui.h"

#define IDC_STATIC -1

// Icon
IDI_CLAMAV_ICON ICON "clamav.ico"

// Main Dialog
IDD_MAIN_DIALOG DIALOGEX 0, 0, 360, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Antivirus Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Scan Status", IDC_STATIC, 10, 10, 340, 100
    LTEXT           "Status: Idle", IDC_STATUS_TEXT, 20, 28, 320, 12
    LTEXT           "Current Folder:", IDC_STATIC, 20, 44, 60, 12
    LTEXT           "", IDC_CURRENT_FOLDER, 85, 44, 255, 12, SS_PATHELLIPSIS
    LTEXT           "", IDC_PROGRESS_TEXT, 20, 60, 320, 12
    CONTROL         "", IDC_PROGRESS_BAR, PROGRESS_CLASS, WS_BORDER, 20, 76, 320, 14
    LTEXT           "Last Scan: Never", IDC_LAST_SCAN, 20, 95, 320, 12
    
    GROUPBOX        "Information", IDC_STATIC, 10, 120, 340, 120
    LTEXT           "Advanced antivirus engine for detecting trojans, viruses, malware and other malicious threats.", IDC_STATIC, 20, 135, 320, 24
    LTEXT           "Use the Scan menu to run virus scans. Configure scheduled scans in Settings > Auto-Scan Settings.", IDC_STATIC, 20, 165, 320, 24
    LTEXT           "Administrator privileges are required for scanning operations.", IDC_STATIC, 20, 195, 320, 12
    LTEXT           "", IDC_SCAN_INFO, 20, 215, 320, 12
END

// About Dialog
IDD_ABOUT_DIALOG DIALOGEX 0, 0, 240, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Antivirus Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_CLAMAV_ICON, IDC_STATIC, 14, 14, 20, 20
    LTEXT           "Antivirus Manager v1.0", IDC_STATIC, 42, 14, 170, 8
    LTEXT           "Copyright (C) 2026, Monitoring Solutions Inc.", IDC_STATIC, 42, 26, 170, 8
    LTEXT           "Advanced antivirus scanning and protection.", IDC_STATIC, 42, 44, 180, 20
    LTEXT           "", IDC_STATIC, 42, 70, 180, 12
    DEFPUSHBUTTON   "OK", UI_ID_CLOSE, 95, 100, 50, 14
END

// Auto-Scan Configuration Dialog
IDD_AUTOSCAN_DIALOG DIALOGEX 0, 0, 280, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Auto-Scan Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable scheduled scans", UI_ID_ENABLE_AUTO, 15, 15, 120, 12
    
    LTEXT           "Scan Interval:", IDC_STATIC, 15, 40, 60, 12
    COMBOBOX        UI_ID_INTERVAL_COMBO, 80, 38, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Scan Type:", IDC_STATIC, 15, 65, 60, 12
    COMBOBOX        UI_ID_SCANTYPE_COMBO, 80, 63, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Note: Scheduled scans will run automatically using Windows Task Scheduler.", IDC_STATIC, 15, 90, 250, 24
    
    DEFPUSHBUTTON   "Save", IDOK, 160, 125, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 215, 125, 50, 14
END

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Monitoring Solutions Inc."
            VALUE "FileDescription", "Antivirus Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "clamav_ui"
            VALUE "LegalCopyright", "Copyright (C) 2026, Monitoring Solutions Inc."
            VALUE "OriginalFilename", "clamav_ui.exe"
            VALUE "ProductName", "Antivirus Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Manifest
UI_MANIFEST_ID RT_MANIFEST "clamav_ui.exe.manifest"

