#include <windows.h>
#include "suricata_ui.h"

#define IDC_STATIC -1

// Icon
IDI_SURICATA_ICON ICON "suricata.ico"

// Main Dialog
100 DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Network Security Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Service Status", IDC_STATIC, 10, 10, 300, 60
    LTEXT           "Status: Unknown", IDC_STATUS_TEXT, 20, 30, 280, 30
    
    GROUPBOX        "Information", IDC_STATIC, 10, 80, 300, 80
    LTEXT           "Network threat detection engine. Use the Manage menu to start or stop the service. Administrator privileges are required.", IDC_STATIC, 20, 95, 280, 60
END

// About Dialog
101 DIALOGEX 0, 0, 220, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Network Security Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_SURICATA_ICON, IDC_STATIC, 14, 14, 20, 20
    LTEXT           "Network Security Manager v1.0", IDC_STATIC, 42, 14, 170, 8
    LTEXT           "Copyright (C) 2026, Monitoring Solutions Inc.", IDC_STATIC, 42, 26, 170, 8
    LTEXT           "Advanced network intrusion detection and prevention system.", IDC_STATIC, 42, 44, 170, 20
    DEFPUSHBUTTON   "OK", UI_ID_CLOSE, 85, 90, 50, 14
END

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Monitoring Solutions Inc."
            VALUE "FileDescription", "Network Security Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "suricata_ui"
            VALUE "LegalCopyright", "Copyright (C) 2026, Monitoring Solutions Inc."
            VALUE "OriginalFilename", "suricata_ui.exe"
            VALUE "ProductName", "Network Security Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Manifest
UI_MANIFEST_ID RT_MANIFEST "suricata_ui.exe.manifest"

