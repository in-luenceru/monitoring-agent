# Makefile for Suricata UI

CC=x86_64-w64-mingw32-gcc
WINDRES=x86_64-w64-mingw32-windres
CFLAGS=-Wall -O2 -DWIN32 -mwindows
LDFLAGS=-lcomctl32 -ladvapi32 -lshell32

# Output
TARGET=suricata_ui.exe

# Source files
SOURCES=suricata_ui.c
RC_FILE=suricata_ui.rc
RES_FILE=suricata_ui.res
MANIFEST=suricata_ui.exe.manifest

# Build
all: $(TARGET)

$(RES_FILE): $(RC_FILE) $(MANIFEST)
	$(WINDRES) $(RC_FILE) -O coff -o $(RES_FILE)

$(TARGET): $(SOURCES) $(RES_FILE)
	$(CC) $(CFLAGS) $(SOURCES) $(RES_FILE) -o $(TARGET) $(LDFLAGS)

clean:
	rm -f $(TARGET) $(RES_FILE) *.o

.PHONY: all clean
