<?xml version="1.0" encoding="UTF-8"?>
<!--
  ClamAV Manual Scan Trigger - Decoder Configuration
  
  Deploy to Wazuh Manager: /var/ossec/etc/decoders/local_decoder.xml
  (Add to existing file or create new one)
  
  This decoder parses the manual scan trigger message format:
  CLAMAV_MANUAL_SCAN scan_type:quickscan
-->

<decoder name="clamav_trigger">
  <prematch>^CLAMAV_MANUAL_SCAN</prematch>
</decoder>

<decoder name="clamav_trigger_params">
  <parent>clamav_trigger</parent>
  <regex offset="after_parent">scan_type:(\w+)</regex>
  <order>scan_type</order>
</decoder>
