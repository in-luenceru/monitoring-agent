<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->

<decoder name="local_decoder_example">
    <program_name>local_decoder_example</program_name>
</decoder>

<!--
  ClamAV Manual Scan Trigger Decoders
  Parses log messages of the form:
    CLAMAV_MANUAL_SCAN scan_type:quickscan
    CLAMAV_MANUAL_SCAN scan_type:fullscan
  Inject via: echo "CLAMAV_MANUAL_SCAN scan_type:quickscan" | /var/ossec/bin/wazuh-logtest
-->
<decoder name="clamav_trigger">
  <prematch>^CLAMAV_MANUAL_SCAN</prematch>
</decoder>

<decoder name="clamav_trigger_params">
  <parent>clamav_trigger</parent>
  <regex offset="after_parent">scan_type:(\w+)</regex>
  <order>scan_type</order>
</decoder>
